{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "apx-ride-public-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api-staging.apxride.com", "custom_domain": true }],
  "services": [{ "binding": "PORTAL", "service": "apx-ride-portal-staging" }],
  "ratelimits": [{ "name": "BOOKING_LIMITER", "namespace_id": "2401", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "EXPECTED_HOSTNAME": "apxride.com",
    "ENVIRONMENT": "staging"
  }
}
