{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apx-ride-portal-production",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "portal.apxride.com", "custom_domain": true },
    { "pattern": "portal-production.apxride.com", "custom_domain": true }
  ],
  "assets": { "directory": "dist/client" },
  "vars": {
    "APX_AUTH_MODE": "cloudflare",
    "CF_ACCESS_TEAM_DOMAIN": "apxride-portal.cloudflareaccess.com",
    "CF_ACCESS_AUD": "131af8d9a6fadcf55717332baed8310015c37ad9a0e403d91fb28f1de5dc025f"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "apx-ride-production",
    "database_id": "191bde87-81f5-4313-84a9-ea38033f12c4",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "apx-ride-production-documents",
    "jurisdiction": "eu"
  }],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
